---
/*
  Base page layout — the shared HTML shell (head + fonts + stylesheet),
  with the Header and Footer wrapped around each page's content (<slot/>), and the
  language suggestion (LangOffer: the same page in the visitor's browser language,
  offered — never switched by itself) after them.
  Pass title/description/active, plus `page` (a key of PAGES or LIMITED_PAGES in src/i18n/index.js)
  and `lang` (the page's language; canonical, hreflang and og:locale follow it).
*/
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LangOffer from '../components/LangOffer.astro';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
// Global stylesheet imported through Astro so it gets a CONTENT-HASHED filename
// (/_astro/styles.[hash].css). Any CSS change → new hash → new URL → Cloudflare
// can never serve a stale stylesheet. Astro injects the <link> into <head>.
// fonts.css = @font-face for our own font files in public/fonts/ (no Google).
import '../styles/fonts.css';
import '../styles/styles.css';
import { LOCALES, DEFAULT_LOCALE, LANGS, PAGES, pageUrl, t } from '../i18n/index.js';

const { title, description = '', active, page, lang } = Astro.props;
if (!page) throw new Error('BaseLayout: pass `page` (a key of PAGES or LIMITED_PAGES in src/i18n/index.js)');
if (!lang) throw new Error('BaseLayout: pass `lang` (the language of the page, e.g. "en")');
const { ui } = t(lang);
const abs = (path) => new URL(path, Astro.site).href;

// Canonical URL — the ONE address Google should index for this page. The home
// page is "/" (never "/index.html"); other pages keep their file URLs
// (tools.html, …). Built from `site` in astro.config.mjs and pageUrl().
const canonical = abs(pageUrl(page, lang));
// The same page in every built language (+ x-default → English). Only once there are 2+ languages.
// Pages for search (PAGES) get hreflang; a LIMITED_PAGES page (Legal notice) is noindex instead.
const indexed = Object.prototype.hasOwnProperty.call(PAGES, page);
const alternates = indexed && LOCALES.length > 1
  ? [...LOCALES.map((l) => ({ hreflang: l, href: abs(pageUrl(page, l)) })), { hreflang: 'x-default', href: abs(pageUrl(page, DEFAULT_LOCALE)) }]
  : [];

// Link preview (Open Graph) — the card messengers/social sites show for a shared
// link. One own image for the whole site (public/assets/og-image.jpg, 1200×630);
// never an Amazon product image. Title/description come from each page.
const ogImage = new URL('/assets/og-image.jpg', Astro.site).href;

// Fonts per language: the files in public/fonts/ every page of the language needs at once (logo, headings,
// text), preloaded so the text doesn't jump when they arrive. All @font-face rules live in src/styles/fonts.css.
// Latin languages (en, de, fr, it, es) share Fraunces + Nunito Sans (latin subset; ä ö ü ß é è ç œ ñ ¿ ¡ are in
// it, rarer letters come from latin-ext on demand); Fraunces has no Cyrillic → Russian headings use Lora
// (styles.css :root:lang(ru)). A new language needs fonts with its script: files + fonts.css + an entry here.
// A language without an entry fails the build (no silent fallback to the English fonts), and so does a missing file.
const LATIN = ['fraunces-v38-latin.woff2', 'nunito-sans-v19-latin.woff2'];
const FONTS = {
  en: LATIN,
  ru: ['lora-3.021-wght.woff2', 'nunito-sans-v19-latin.woff2', 'nunito-sans-v19-cyrillic.woff2'],
  de: LATIN,
  fr: LATIN,
  it: LATIN,
  es: LATIN,
};
const preloadFonts = FONTS[lang];
if (!preloadFonts) throw new Error(`BaseLayout: no FONTS entry for language "${lang}"`);
for (const file of preloadFonts) {
  if (!existsSync(join(process.cwd(), 'public', 'fonts', file))) throw new Error(`BaseLayout: FONTS (${lang}) — public/fonts/${file} does not exist`);
}
---
<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {!indexed && <meta name="robots" content="noindex" />}
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}

  <!-- Site icon: patchwork pinwheel (browser tab, bookmarks, iPhone home screen). -->
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <!-- Link preview card (WhatsApp, Telegram, Facebook, Pinterest, Threads, iMessage…). -->
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="My Sewing Picks" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:type" content="image/jpeg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={ui.ogImageAlt} />
  <meta property="og:locale" content={LANGS[lang].ogLocale} />
  <meta name="twitter:card" content="summary_large_image" />

  <!-- Warm, cozy fonts — our own files (public/fonts/), never Google; layout still works without them. -->
  {preloadFonts.map((file) => <link rel="preload" href={`/fonts/${file}`} as="font" type="font/woff2" crossorigin />)}

  <!-- The hashed <link rel="stylesheet"> for our global CSS is injected here by
       Astro (from the `import '../styles/styles.css'` above). No manual link. -->
</head>
<body>
  <Header active={active} page={page} lang={lang} />
  <slot />
  <Footer lang={lang} />
  <LangOffer page={page} lang={lang} />
</body>
</html>
