---
/* Tools page — one template for every language (src/i18n). Product cards are
   rendered STATICALLY at build, split into sections by src/data/categories.js.
   Above them, after the disclosure, the sewing room (src/components/Room.astro):
   its four zones link to the sections below (no JS needed). */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductSections from '../../components/ProductSections.astro';
import Room from '../../components/Room.astro';
import { localePaths, langOf, t } from '../../i18n/index.js';

export const getStaticPaths = localePaths;
const lang = langOf(Astro.params);
const { brand, ui, pages: { tools: text } } = t(lang);
---
<BaseLayout lang={lang} page="tools" active="tools" title={text.title} description={text.description}>
  <main>
    <section class="section section--catalog">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{brand}</span>
          <h1>{text.heading}</h1>
          <p>{text.intro}</p>
        </div>

        <!-- Page-level affiliate disclosure, shown before any affiliate link. -->
        <p class="page-disclosure">{ui.pageDisclosure}</p>

        <!-- The sewing room: its zones jump to the sections below (no JS needed). -->
        <Room room="tools" lang={lang} />

        <ProductSections category="tools" lang={lang} />
      </div>
    </section>
  </main>
</BaseLayout>
