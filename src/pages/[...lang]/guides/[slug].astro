---
/*
  Guide page — one sewing technique (src/data/guides.js); ONE template for every guide and every
  language (texts: src/i18n). Like a project page: the head (h1 = heading, the blurb) → page-disclosure
  (the figure's "In this step" links are affiliate links) → the animated figure (AnatomyFigure, model =
  guide.figure: src/lib/anatomy/<figure>.js) → the projects' own videos, each from where the technique
  begins (video[].start) → "What you'll need" (catalog cards) → back to the list.
  Right after the figure: "Where it's used" — one plain link per usedIn entry to that project's page
  (the same pairs the project figures link back from with "How it's done ->"; not affiliate links).
  A guide with `sections` (several ways to do one thing, one figure each) is laid out by them: h1 + blurb →
  contents (a link #id + line per section) → page-disclosure → a <section id> each (h2 = title, "When to
  choose it", its figure, the optional sentence `rest` with a plain link to the section that shows the rest of the work
  (`restIn`, same page), its "Where it's used" with the section's optional note under the links) → videos → "What you'll need" → back to the list. The
  "How it's done" links in the projects point at these #ids (src/lib/guidePage.js).
  A wrong product id, project or project step in guides.js fails the build.
  Spec: Vault «Гайды — спецификация», 5–6.
*/
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AnatomyFigure from '../../../components/AnatomyFigure.astro';
import ProductCard from '../../../components/ProductCard.astro';
import YouTubeVideo from '../../../components/YouTubeVideo.astro';
import { guides, guideBySlug, guideSections } from '../../../data/guides.js';
import { projectBySlug } from '../../../data/projects.js';
import { products } from '../../../data/products.js';
import { LOCALES, DEFAULT_LOCALE, langOf, pageUrl, t } from '../../../i18n/index.js';
import { guideText, projectText } from '../../../i18n/content.js';
import { figure } from '../../../lib/anatomy/figures.js';

export const getStaticPaths = () =>
  LOCALES.flatMap((lang) => guides.map((g) => ({ params: { lang: lang === DEFAULT_LOCALE ? undefined : lang, slug: g.slug } })));

const lang = langOf(Astro.params);
const guide = guideText(guideBySlug(Astro.params.slug), lang);
const { ui, pages: { guide: text } } = t(lang);
const where = `guides.js "${guide.slug}"`;

const needs = guide.needs.map((id) => {
  const p = products.find((x) => x.id === id);
  if (!p) throw new Error(`${where}: unknown product "${id}"`);
  return p;
});
// usedIn: real projects and real steps of their figures (a project's figure has the project's slug).
// A guide with sections has its figure and usedIn per section; a plain one is a single section with no id.
const sectioned = guide.sections !== undefined;
const sections = guideSections(guide).map((s, _, all) => {
  for (const u of s.usedIn) {
    projectBySlug(u.project);
    const last = figure(u.project).model.STEPS.length - 1;
    for (const k of u.steps) {
      if (!Number.isInteger(k) || k < 1 || k > last) throw new Error(`${where}: usedIn "${u.project}" step ${k} is not in 1…${last}`);
    }
  }
  // "Where it's used": a link to each project, with the steps where the technique is used.
  const usedIn = s.usedIn.map((u) => ({
    url: pageUrl(`project/${u.project}`, lang),
    text: text.usedInSteps(projectText(projectBySlug(u.project), lang).title, u.steps),
  }));
  // restIn: the rest of the work is in another section of this page — a plain link to its #id, with its number and title.
  const restTo = s.restIn ? { id: s.restIn, n: all.findIndex((x) => x.id === s.restIn) + 1, title: all.find((x) => x.id === s.restIn).title } : null;
  return { ...s, usedIn, restTo };
});
// The projects' own videos (id, cover, title), each from where the technique begins.
const videos = (guide.video ?? []).map((v) => {
  const p = projectText(projectBySlug(v.project), lang);
  return { id: p.video, title: p.videoTitle, intro: text.videoIntro(p.title), start: v.start };
});
---
<BaseLayout lang={lang} page={`guide/${guide.slug}`} active="guides" title={guide.pageTitle} description={guide.pageDescription}>
  <main>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{text.eyebrow}</span>
          <h1>{guide.heading}</h1>
          <p>{guide.blurb}</p>
        </div>
        {sectioned && (
        <nav class="section-chips guide-chips" aria-label={text.kindsHeading}>
          <p class="guide-chips__label">{text.kindsHeading}</p>
          <div class="section-chips__track">
            {sections.map((s, i) => (
              <a class="section-chip" href={`#${s.id}`}><span class="section-chip__count">{i + 1}</span>{s.title}</a>
            ))}
          </div>
        </nav>
    )}
        <!-- Page-level affiliate disclosure, shown before any affiliate link. -->
        <p class="page-disclosure">{ui.pageDisclosureSome}</p>

        {!sectioned && <AnatomyFigure model={sections[0].figure} lang={lang} />}
      </div>
    </section>
    {sectioned && sections.map((s) => (
      <section class="section guide-section" id={s.id}>
        <div class="container">
          <div class="section-head">
            <h2>{s.title}</h2>
            <p>{s.line}</p>
          </div>
          <div class="guide-choose">
            <h3>{text.chooseHeading}</h3>
            <p>{s.choose}</p>
          </div>
          <AnatomyFigure model={s.figure} lang={lang} />
          {s.restTo && (
            <p class="guide-rest">{s.rest} <a class="guide-rest__link" href={`#${s.restTo.id}`}><span class="section-chip__count">{s.restTo.n}</span>{s.restTo.title} ↑</a></p>
          )}
          {(s.usedIn.length > 0 || s.note) && (
            <div class="guide-used">
              <div class="section-head">
                <span class="eyebrow">{text.usedInEyebrow}</span>
                <h3>{text.usedInHeading}</h3>
              </div>
              {s.usedIn.length > 0 && (
                <ul class="guide-used__list">
                  {s.usedIn.map((u) => <li><a class="btn btn--ghost" href={u.url}>{u.text}</a></li>)}
                </ul>
              )}
              {s.note && <p class="guide-used__note">{s.note}</p>}
            </div>
          )}
        </div>
      </section>
    ))}{!sectioned && sections[0].usedIn.length > 0 && (
      <section class="section section--tight">
        <div class="container guide-used">
          <div class="section-head">
            <span class="eyebrow">{text.usedInEyebrow}</span>
            <h2>{text.usedInHeading}</h2>
          </div>
          <ul class="guide-used__list">
            {sections[0].usedIn.map((u) => <li><a class="btn btn--ghost" href={u.url}>{u.text}</a></li>)}
          </ul>
        </div>
      </section>
    )}

    {videos.length > 0 && (
      <section class="section section--tight">
        <div class="container guide-video">
          <div class="section-head">
            <span class="eyebrow">{text.videoEyebrow}</span>
            <h2>{text.videoHeading}</h2>
          </div>
          {videos.map((v) => (
            <div class="guide-video__item">
              <p class="guide-video__intro">{v.intro}</p>
              <YouTubeVideo id={v.id} title={v.title} lang={lang} start={v.start} />
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{text.needsEyebrow}</span>
          <h2>{text.needsHeading}</h2>
          <p>{guide.needsIntro}</p>
        </div>
        <div class="product-grid">
          {needs.map((product) => <ProductCard product={product} lang={lang} />)}
        </div>
        <p class="guide-more"><a href={pageUrl('guides', lang)}>{text.more}</a></p>
      </div>
    </section>
  </main>
</BaseLayout>

{sectioned && (
  <script>
    // Highlight the chip of the way on screen (the same chips as the catalog pages).
    import { watchSectionChips } from '../../../lib/sectionChips.js';
    watchSectionChips('.guide-section');
  </script>
)}

<style>
  /* A section is reached by its #id (contents, "How it's done" in the projects): keep its heading clear of the sticky header. */
  /* The ways as the catalog pages' chips, numbered, right under the intro: all four seen at once. Not sticky —
     the long names wrap to several rows on a phone, too tall to stay under the header. */
  .guide-chips { position: static; margin: 0 auto 24px; padding: 0; background: none; backdrop-filter: none; border-bottom: 0; }
  .guide-chips .section-chips__track { flex-wrap: wrap; justify-content: center; overflow-x: visible; padding-inline: 0; }
  .guide-chips .section-chip { margin: 0; }
  .guide-chips__label { margin: 0 0 10px; text-align: center; font-weight: 700; }
  .guide-section { scroll-margin-top: calc(var(--header-h) + 12px); }
  .guide-choose { max-width: 760px; margin: 0 auto 24px; text-align: center; }
  .guide-choose h3 { font-size: 1rem; margin: 0 0 6px; }
  .guide-choose p { margin: 0; }
  .guide-section .guide-used { margin-top: 28px; }
  .guide-used__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }
  .guide-used .section-head { margin-bottom: 24px; }
  .guide-rest { max-width: 760px; margin: 22px auto 0; text-align: center; } /* the rest of the work: another section, by its #id */
  .guide-rest__link { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; white-space: normal; }
  .guide-used__note { max-width: 760px; margin: 18px auto 0; text-align: center; color: var(--ink-soft); } /* a section's note, under its projects */
  .guide-video { max-width: 760px; }
  .guide-video__item + .guide-video__item { margin-top: 36px; }
  .guide-video__intro { margin: 0 0 12px; text-align: center; color: var(--ink-soft); }
  .guide-more { text-align: center; margin-top: 40px; font-weight: 700; }
</style>
