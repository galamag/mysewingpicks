---
/* Guides — the list of sewing guides (src/data/guides.js), one template for every language
   (src/i18n). The groups come in the order of GUIDE_GROUPS; a group with no guide is not shown
   (liveGroups) — no empty section, no anchor to nowhere. Each group is a <section id={group}>
   with its guides as cards. Above them, the classroom (src/components/Room.astro, model
   src/lib/rooms/guides.js): a zone per group jumps to it; the zone of a group with no guide is
   decoration. No affiliate links on this page (the room links only to the groups below), so no
   page-disclosure. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Room from '../../components/Room.astro';
import { guides, liveGroups } from '../../data/guides.js';
import { localePaths, langOf, pageUrl, t } from '../../i18n/index.js';
import { guideText } from '../../i18n/content.js';

export const getStaticPaths = localePaths;
const lang = langOf(Astro.params);
const { pages: { guides: text } } = t(lang);
const groups = liveGroups().map((id) => ({
  id,
  ...text.groups[id],
  items: guides.filter((g) => g.group === id).map((g) => guideText(g, lang)),
}));
const gridClass = (n) => `category-grid${n === 1 ? ' category-grid--single' : n === 2 ? ' category-grid--pair' : ''}`;
---
<BaseLayout lang={lang} page="guides" active="guides" title={text.title} description={text.description}>
  <main>
    <section class="section guides-top">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">{text.eyebrow}</span>
          <h1>{text.heading}</h1>
          <p>{text.intro}</p>
        </div>

        <!-- The classroom: its zones jump to the groups below (no JS needed). -->
        <Room room="guides" lang={lang} />
      </div>
    </section>

    {groups.map((group) => (
      <section class="section section--tight guide-group" id={group.id}>
        <div class="container">
          <div class="section-head">
            <h2>{group.title}</h2>
            <p>{group.intro}</p>
          </div>
          <div class={gridClass(group.items.length)}>
            {group.items.map((g) => (
              <a class="category-card category-card--tools" href={pageUrl(`guide/${g.slug}`, lang)}>
                <div class="category-card__icon" aria-hidden="true">{g.icon}</div>
                <h3>{g.title}</h3>
                <p>{g.blurb}</p>
                <span class="category-card__more">{text.more}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}
  </main>
</BaseLayout>

<style>
  /* the classroom and the first group: one gap (the group's own), not two */
  .guides-top { padding-bottom: 0; }
  .guides-top :global(.room) { margin-bottom: 0; }
  /* a jump to a group (#construction) keeps its heading clear of the sticky header */
  .guide-group { scroll-margin-top: var(--header-h); }
</style>
