---
/*
  Project page: the tote bag. Animated anatomy + steps (ToteAnatomy), the
  maker's video (YouTube loads only when tapped) and "What you'll need"
  (catalog cards). Data: src/data/projects.js · model: src/lib/anatomy/tote.js.
*/
import BaseLayout from '../../layouts/BaseLayout.astro';
import ToteAnatomy from '../../components/ToteAnatomy.astro';
import ProductCard from '../../components/ProductCard.astro';
import YouTubeVideo from '../../components/YouTubeVideo.astro';
import { projectBySlug } from '../../data/projects.js';
import { products } from '../../data/products.js';

const project = projectBySlug('tote-bag');
const needs = project.needs.map((id) => {
  const p = products.find((x) => x.id === id);
  if (!p) throw new Error(`tote-bag: unknown product "${id}" in projects.js`);
  return p;
});
---
<BaseLayout
  title="How to Sew a Lined Tote Bag, Step by Step — My Sewing Picks"
  description="An animated, step-by-step guide to a lined tote bag with long straps: real cutting sizes, folding the straps, boxed corners, the lining and topstitching."
  active="projects"
>
  <main>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Sew along · project</span>
          <h2>{project.title}</h2>
          <p>{project.blurb}</p>
        </div>

        <!-- Page-level affiliate disclosure, shown before any affiliate link. -->
        <p class="page-disclosure">Some links on this page are affiliate links. As an Amazon Associate I earn from qualifying purchases.</p>

        <ToteAnatomy />
      </div>
    </section>

    <section class="section section--tight">
      <div class="container project-video">
        <div class="section-head">
          <span class="eyebrow">Watch it made</span>
          <h2>The video</h2>
          <p>The whole bag, sewn start to finish on the channel.</p>
        </div>
        <YouTubeVideo id={project.video} title="Sew in 10 minutes — a lined tote bag" />
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">For this project</span>
          <h2>What you'll need</h2>
          <p>Cotton duck for the outer and straps, satin for the lining, thread — and the tools
             I personally recommend for cutting, pressing and sewing it.</p>
        </div>
        <div class="product-grid">
          {needs.map((product) => <ProductCard product={product} />)}
        </div>
        <p class="project-more"><a href="/projects.html">← More sew-along projects</a></p>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .project-video { max-width: 760px; }
  .project-more { text-align: center; margin-top: 32px; font-weight: 700; }
</style>
