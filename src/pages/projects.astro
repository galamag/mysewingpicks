---
/* Projects — the list of sew-along projects (src/data/projects.js). */
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects.js';
---
<BaseLayout
  title="Sew-Along Projects — My Sewing Picks"
  description="Step-by-step sewing projects with animated guides, real cutting sizes and the video from the SEWING DIY PATCHWORK channel."
  active="projects"
>
  <main>
    <section class="section">
      <div class="container">
        <div class="section-head">
          <span class="eyebrow">Sew along</span>
          <h2>Projects</h2>
          <p>Pick a project and watch it come together, step by step — every piece with its
             real size, every seam animated, plus the video and what you'll need.</p>
        </div>

        <div class={`category-grid${projects.length === 1 ? ' category-grid--single' : ''}`}>
          {projects.map((p) => (
            <a class="category-card category-card--fabrics" href={`/projects/${p.slug}.html`}>
              <div class="category-card__icon" aria-hidden="true">{p.icon}</div>
              <h3>{p.title}</h3>
              <p>{p.blurb}</p>
              <span class="category-card__more">See it step by step →</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
