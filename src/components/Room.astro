---
/*
  Room — the isometric room at the top of a section page, drawn at BUILD time
  (src/lib/rooms/): the first frame is plain SVG in the HTML and every item is an
  ordinary link, so it works without JS.
    room  'setup' | 'tools' | 'fabrics' | 'projects' | 'guides' | 'about' (the model: ROOMS in src/lib/rooms/rooms.js)
    lang  the page's language

  A room with no links (about: the maker's corner of /about.html) is a picture: the svg is an
  image (role img, its name as the aria-label) and there is no hint under it.

  Nothing in the drawing links to Amazon. An item leads to OUR page:
    product → its card in the list below (#product-<id>, ProductCard `anchor`)
    section → the section of the list (#<section id>); in the classroom (guides) a group of
              guides, named by its title on the guides page
    project → the project page in this language (pageUrl)
  checkTargets fails the build when a part points at a product, section or project
  that does not exist; a section without products (a group without guides) turns its
  part into decoration.

  The sheet: a room with at least one product item gets ONE <dialog class="room-sheet">.
  Tapping an item shows a CLONE of that product's card from the list below (the ONE
  ProductCard: "View on Amazon" and the paid-link marker come along) — never a second
  card markup. Without <dialog>.showModal, without JS, or with a modifier key the tap is
  an ordinary link to the card. The script only highlights and opens / closes the sheet.

  Styles: src/styles/styles.css, "Rooms & house" — the svg is injected with set:html,
  scoped styles would not reach it.
*/
import { ROOMS, ROOM_CATEGORY, catalogOf } from '../lib/rooms/rooms.js';
import { renderRoom, minHitFor } from '../lib/rooms/render.js';
import { checkTargets } from '../lib/rooms/check.js';
import { products } from '../data/products.js';
import { projects } from '../data/projects.js';
import { pageUrl, t } from '../i18n/index.js';
import { productText, groupTitle, projectText } from '../i18n/content.js';

const { room, lang } = Astro.props;
const model = ROOMS[room];
if (!model) throw new Error(`Room: no model for "${room}" (src/lib/rooms/rooms.js)`);
const category = ROOM_CATEGORY[room];
const { ui, pages } = t(lang);

const { inactive } = checkTargets(model, catalogOf(category));

/** A section's name: a group of the catalogue, or (the classroom) a group of guides. */
const sectionTitle = (id) => (room === 'guides' ? pages.guides.groups[id].title : groupTitle(category, id, lang));

/** A part's target → our link: { href, label, kind } (check.js has made sure it exists). */
function resolve(target) {
  if (target.product) {
    const product = products.find((p) => p.id === target.product);
    return { href: `#product-${product.id}`, label: productText(product, lang).name, kind: 'product' };
  }
  if (target.section) {
    return { href: `#${target.section}`, label: sectionTitle(target.section), kind: 'section' };
  }
  if (target.project) {
    const project = projects.find((p) => p.slug === target.project);
    return { href: pageUrl(`project/${project.slug}`, lang), label: projectText(project, lang).title, kind: 'page' };
  }
  return null;
}

// Tap areas of at least a thumb on the narrowest phone, where the room is as wide as the
// screen (full-bleed on phones, styles.css): minHit in viewBox units, see minHitFor.
const prefix = `room-${model.key}`;
const { svg, viewBox, hots } = renderRoom(model, { prefix, resolve, inactive, minHit: minHitFor(model) });

const hasSheet = hots.some((h) => h.kind === 'product');
// nothing to tap (about): a picture, not a group of links
const picture = hots.length === 0;

// what to tap; a picture has nothing to tap, so no hint (and no caption at all)
const HINT = { setup: ui.rooms.tapItem, tools: ui.rooms.tapShelf, fabrics: ui.rooms.tapShelf, projects: ui.rooms.tapProject, guides: ui.rooms.tapShelf };
const hint = picture ? null : HINT[room];
---
<figure class="room" data-room={room}>
  <svg class="room__svg" viewBox={viewBox.join(' ')} role={picture ? 'img' : 'group'} aria-label={ui.rooms.roomLabel(ui.nav[room])} set:html={svg} />
  {hint && <figcaption class="room__hint">{hint}</figcaption>}
</figure>
{hasSheet && (
  <dialog class="room-sheet" data-room={room}>
    <button type="button" class="room-sheet__close" aria-label={ui.rooms.close} title={ui.rooms.close} autofocus><span aria-hidden="true">×</span></button>
    <div class="room-sheet__body"></div>
  </dialog>
)}

<script>
  // Highlight the item under the pointer / with focus; open the product sheet.
  document.querySelectorAll('.room').forEach((room) => {
    const sheet = document.querySelector('.room-sheet[data-room="' + room.getAttribute('data-room') + '"]');
    const body = sheet && sheet.querySelector('.room-sheet__body');
    let hover = null;   // part under the pointer or with focus
    let shown = null;   // part whose card is in the sheet
    let opener = null;  // the link that opened the sheet: focus goes back to it
    let quiet = false;  // while focus is handed back, no glow
    let pressed = null; // where the last mouse press began (a drag out of the card is not a backdrop tap)

    const light = () => {
      room.querySelectorAll('.room__part').forEach((g) => {
        const part = g.getAttribute('data-part');
        g.classList.toggle('is-on', part === hover || part === shown);
      });
    };
    const partOf = (e) => {
      const a = e.target.closest && e.target.closest('.room__hot');
      return a ? a.getAttribute('data-part') : null;
    };
    const set = (part) => { hover = part; light(); };

    room.addEventListener('focusin', (e) => { if (!quiet) set(partOf(e)); });
    room.addEventListener('focusout', () => set(null));
    // Not on touch screens: a tap there would leave the item lit.
    if (window.matchMedia && window.matchMedia('(hover: hover)').matches) {
      room.addEventListener('mouseover', (e) => set(partOf(e)));
      room.addEventListener('mouseout', () => set(null));
    }

    if (!sheet || !body) return;

    room.addEventListener('click', (e) => {
      const hot = e.target.closest && e.target.closest('.room__hot[data-kind="product"]');
      if (!hot || e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
      if (typeof sheet.showModal !== 'function') return; // no <dialog>: the link scrolls to the card
      const card = document.getElementById((hot.getAttribute('href') || '').slice(1));
      if (!card) return;

      // The same card, copied: ids (the original keeps its own) must not repeat on the page.
      const copy = card.cloneNode(true);
      copy.removeAttribute('id');
      copy.querySelectorAll('[id]').forEach((n) => n.removeAttribute('id'));
      body.textContent = '';
      body.appendChild(copy);
      sheet.setAttribute('aria-label', hot.getAttribute('aria-label') || '');
      try {
        sheet.showModal();
      } catch (err) {
        body.textContent = ''; // could not open: leave the link to do its job
        return;
      }
      e.preventDefault();
      opener = hot;
      shown = hot.getAttribute('data-part');
      light();
    });

    sheet.querySelector('.room-sheet__close').addEventListener('click', () => sheet.close());
    // A press and release on the dimmed page around the sheet (the dialog itself) closes it.
    sheet.addEventListener('mousedown', (e) => { pressed = e.target; });
    sheet.addEventListener('click', (e) => {
      if (e.target === sheet && (pressed === null || pressed === sheet)) sheet.close();
      pressed = null;
    });
    // Esc, the cross and the backdrop all end here.
    sheet.addEventListener('close', () => {
      body.textContent = '';
      shown = null;
      hover = null;
      light();
      if (opener) {
        quiet = true;
        if (opener.focus) opener.focus();
        quiet = false;
        opener = null;
      }
    });
  });
</script>
