---
/*
  Shared site header — logo + primary nav + mobile hamburger.
  Reused on every page. Pass `active` (e.g. "about") to highlight the
  current page's nav link, `lang` (the page's language) and `page` (its key
  in src/i18n/index.js). The language switcher (EN · RU) leads to the SAME page
  (`page`) in the other language — the current language is a plain span.

  Styled by src/styles/styles.css (.site-header, .site-nav, .nav-toggle).
*/
import { LOCALES, LANGS, pageUrl, t } from '../i18n/index.js';

const { active, page, lang } = Astro.props;
const { brand, ui } = t(lang);
const nav = ['home', 'tools', 'fabrics', 'projects', 'setup', 'about']
  .map((key) => ({ key, label: ui.nav[key], href: pageUrl(key, lang) }));
// Links come from pageUrl(): absolute (pages in sub-folders use the same nav),
// and in the page's own language.
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={pageUrl('home', lang)} aria-label={`${brand} — ${ui.homeLabel}`}>
      <!-- Logo image. If /assets/logo.png is missing, onerror swaps in a text wordmark. -->
      <img
        class="brand__logo"
        src="/assets/logo.png"
        alt={`${brand} ${ui.logo}`}
        onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';"
      />
      <span class="brand__wordmark" style="display:none;">{brand}</span>
    </a>

    <!-- Hamburger toggle (shown on small screens via CSS) -->
    <button class="nav-toggle" aria-label={ui.toggleMenu} aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" aria-label={ui.primaryNav}>
      {nav.map((item) => (
        <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>
      ))}
      {LOCALES.length > 1 && (
        <div class="lang-switch" role="group" aria-label={ui.language}>
          {LOCALES.map((l) => l === lang
            ? <span class="lang-switch__item" aria-current="true" lang={l}>{LANGS[l].label}</span>
            : <a class="lang-switch__item" href={pageUrl(page, l)} hreflang={l} lang={l} title={LANGS[l].name}>{LANGS[l].label}</a>
          )}
        </div>
      )}
    </nav>
  </div>
</header>

<script>
  // Mobile menu open/close (mirrors the old js/site.js hamburger behavior).
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.nav-toggle');
  const nav = header?.querySelector('.site-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>
