---
/*
  Shared site header — logo + primary nav + mobile hamburger.
  Reused on every page. Pass `active` (e.g. "about") to highlight the
  current page's nav link, `lang` (the page's language) and `page` (its key
  in src/i18n/index.js). The language switcher is a `<details>` list (works without
  JS): every language by its own name, each link leads to the SAME page (`page`) in
  that language — a page that does not exist in that language (Legal notice) → that
  language's home page; the current language is a plain span.

  Styled by src/styles/styles.css (.site-header, .site-nav, .nav-toggle).
*/
import { LOCALES, LANGS, hasPage, pageUrl, t } from '../i18n/index.js';

const { active, page, lang } = Astro.props;
const { brand, ui } = t(lang);
const nav = ['home', 'projects', 'tools', 'fabrics', 'setup', 'about']
  .map((key) => ({ key, label: ui.nav[key], href: pageUrl(key, lang) }));
// Links come from pageUrl(): absolute (pages in sub-folders use the same nav),
// and in the page's own language.
---
<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={pageUrl('home', lang)} aria-label={`${brand} — ${ui.homeLabel}`}>
      <!-- Logo image. If /assets/logo.png is missing, onerror swaps in a text wordmark. -->
      <img
        class="brand__logo"
        src="/assets/logo.png"
        alt={`${brand} ${ui.logo}`}
        onerror="this.style.display='none'; this.nextElementSibling.style.display='inline';"
      />
      <span class="brand__wordmark" style="display:none;">{brand}</span>
    </a>

    <!-- Hamburger toggle (shown on small screens via CSS) -->
    <button class="nav-toggle" aria-label={ui.toggleMenu} aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <nav class="site-nav" aria-label={ui.primaryNav}>
      {nav.map((item) => (
        <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>{item.label}</a>
      ))}
      {LOCALES.length > 1 && (
        <details class="lang-switch">
          <summary class="lang-switch__current" aria-label={`${ui.language}: ${LANGS[lang].name}`}>
            <svg class="lang-switch__globe" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9.25" /><path d="M2.75 12h18.5M12 2.75c2.5 2.6 3.9 5.9 3.9 9.25s-1.4 6.65-3.9 9.25c-2.5-2.6-3.9-5.9-3.9-9.25S9.5 5.35 12 2.75Z" /></svg>
            <span lang={lang}>{LANGS[lang].name}</span>
            <span class="lang-switch__caret" aria-hidden="true">▾</span>
          </summary>
          <ul class="lang-switch__list">
            {LOCALES.map((l) => (
              <li>
                {l === lang
                  ? <span class="lang-switch__item" aria-current="true" lang={l}>{LANGS[l].name}</span>
                  : <a class="lang-switch__item" href={hasPage(page, l) ? pageUrl(page, l) : pageUrl('home', l)} hreflang={l} lang={l}>{LANGS[l].name}</a>}
              </li>
            ))}
          </ul>
        </details>
      )}
    </nav>
  </div>
</header>

<script>
  // Mobile menu open/close (mirrors the old js/site.js hamburger behavior).
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.nav-toggle');
  const nav = header?.querySelector('.site-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
    });
  }

  // Language list: close it on a click elsewhere or on Esc. Without JS it closes on a second tap.
  const langs = header?.querySelector<HTMLDetailsElement>('.lang-switch');
  if (langs) {
    document.addEventListener('click', (e) => {
      if (langs.open && !langs.contains(e.target as Node)) langs.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && langs.open) {
        langs.open = false;
        langs.querySelector('summary')?.focus();
      }
    });
  }
</script>
